# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
# Everything our tasks write outside the tree: the manager binary, the envtest assets, the code generators
bin/*
# helm package output of the release workflow
/dist/
/graphify-out/*

# Test binary, built with `go test -c`
*.test

# Go workspace file
go.work

# Kubeconfig files — may contain private keys and cluster credentials
kubeconfig
*.kubeconfig
kubeconfig.*

# editor and IDE paraphernalia
.idea
.vscode
*.swp
*.swo
*~

# Root build artifacts of `go build ./cmd/<name>` (the images compile inside Docker)
/proxy
/ovs-diag

.DS_Store
.worktrees/

# Agent development files (kept locally, not in git)
/AGENTS.md
/CLAUDE.md
/.claude/
/.superpowers/
/docs/superpowers/
