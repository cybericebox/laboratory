{
  "cniVersion": "0.3.1",
  "name": "cybericebox",
  "plugins": [
    {
      "type": "cni-gate",
      "agentSocket": "/run/cybericebox/node-agent.sock",
      "delegate": {
        "type": "ptp",
        "ipMasq": true,
        "mtu": 1500,
        "ipam": {
          "type": "host-local",
          "dataDir": "/run/cni-ipam-state",
          "ranges": [
            [{"subnet": "10.244.0.0/16"}]
          ],
          "routes": [{"dst": "0.0.0.0/0"}]
        }
      }
    }
  ]
}
