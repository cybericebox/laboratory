{
  "cniVersion": "1.0.0",
  "name": "cybericebox",
  "plugins": [
    {
      "type": "cni-gate",
      "agentSocket": "/run/cybericebox/node-agent.sock",
      "delegate": {
        "type": "bridge",
        "bridge": "cni0",
        "isGateway": true,
        "ipMasq": true,
        "ipam": {
          "type": "host-local",
          "subnet": "10.244.0.0/16",
          "routes": [{"dst": "0.0.0.0/0"}]
        }
      }
    }
  ]
}
