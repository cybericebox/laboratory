#!/usr/bin/env bash
#MISE description="Delete the kind cluster of the e2e tests and the upstream registry container the tests started. Env: KIND_CLUSTER_NAME (default kind), CONTAINER_TOOL (docker)"
set -euo pipefail
cd "${MISE_PROJECT_ROOT:?run through mise}"
kind delete cluster --name "${KIND_CLUSTER_NAME:-kind}"
"${CONTAINER_TOOL:-docker}" rm -f registry.e2e.test || true
